repository-code: "https://github.com/aditya-an1l/rasch-per"
url: "https://github.com/aditya-an1l/rasch-per"
license: MIT
version: 0.1.0
date-released: 2026-08-27
keywords:
  - psychometrics
  - rasch
  - item response theory
  - education research
  - physics education research
